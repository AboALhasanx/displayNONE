{
  "manifest_version": 3,
  "name": "displayNONE - Hide Element Inspector",
  "version": "1.0.0",
  "description": "Click any element to set display:none. Reveal mode restores hidden elements. Style-only edits, zero background memory usage.",
  "permissions": ["activeTab", "scripting", "storage"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "displayNONE",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "toggle-hide-mode": {
      "suggested_key": {
        "default": "Ctrl+Shift+X"
      },
      "description": "Toggle hide mode (click an element to set display:none)"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
